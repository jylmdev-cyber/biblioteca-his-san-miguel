---
import '../styles/global.css';
import { urlFor } from '../lib/urls';
import {
  Home,
  BookOpen,
  Hash,
  Compass,
  CheckSquare,
  ArrowUpRight,
  ExternalLink,
  ShieldCheck,
  Building2,
  FileText
} from 'lucide-react';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Biblioteca digital de manuales HIS MINSA para el personal asistencial y puntos de digitación de la RIS San Miguel.'
} = Astro.props;

const current = Astro.url.pathname;

const nav = [
  { href: urlFor(''), label: 'Inicio', icon: Home },
  { href: urlFor('manuales/'), label: 'Manuales', icon: BookOpen },
  { href: urlFor('codigos/'), label: 'Códigos HIS', icon: Hash },
  { href: urlFor('guia-his/'), label: 'Guía rápida', icon: Compass },
  { href: urlFor('puntos-digitacion/'), label: 'Digitación', icon: CheckSquare },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f6f9fa" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={urlFor('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title} | Biblioteca HIS · RIS San Miguel</title>
    <script is:inline>
      try {
        const saved=localStorage.getItem('his-theme');
        const dark=saved==='dark'||(!saved&&window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark',dark);
        document.documentElement.style.colorScheme=dark?'dark':'light';
        const meta=document.querySelector('meta[name="theme-color"]');
        if(meta)meta.setAttribute('content',dark?'#131d27':'#f6f9fa');
      } catch (_) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:z-[100] focus:top-2 focus:left-2 focus:rounded-xl focus:bg-card focus:p-3 focus:text-foreground focus:shadow-xl">Saltar al contenido</a>
    <header class="glass-header sticky top-0 z-40 border-b border-border">
      <div class="container-site flex min-h-[76px] items-center justify-between gap-3">
        <a href={urlFor('')} class="ui-link flex min-w-0 items-center gap-3" aria-label="Biblioteca HIS - Inicio">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-primary shadow-sm" aria-hidden="true">
            <svg viewBox="0 0 28 28" width="27" height="27" fill="none"><path d="M4 6.5h8.5c2 0 3.7.9 5 2.5 1.3-1.6 3-2.5 5-2.5H24V23H15c-1.8 0-2.7.8-2.7 1.5V9c-1.3-1.6-3-2.5-5-2.5H4V22" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 15h6m-3-3v6" stroke="white" stroke-width="1.8" stroke-linecap="round"/></svg>
          </span>
          <span class="min-w-0">
            <strong class="block truncate text-[15px] font-extrabold tracking-tight leading-tight">Biblioteca HIS</strong>
            <small class="block truncate text-[10px] font-bold uppercase tracking-[.15em] text-muted-foreground">RIS San Miguel · Cajamarca</small>
          </span>
        </a>
        <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
          {nav.map(n => {
            const Icon = n.icon;
            const isCurrent = current === n.href || (n.href !== urlFor('') && current.startsWith(n.href));
            return (
              <a
                href={n.href}
                aria-current={isCurrent ? 'page' : undefined}
                class:list={[
                  'nav-link ui-link inline-flex items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-colors duration-150 hover:bg-surface-hover',
                  isCurrent ? 'text-primary bg-accent/70' : 'text-muted-foreground'
                ]}
              >
                <Icon className="size-4 shrink-0 opacity-80" aria-hidden="true" />
                <span>{n.label}</span>
              </a>
            );
          })}
        </nav>
        <div class="flex items-center gap-2">
          <button id="theme-toggle" type="button" class="ui-action grid size-11 place-items-center rounded-xl border border-border bg-card text-foreground hover:border-primary/40 hover:bg-accent" aria-label="Activar modo oscuro" aria-pressed="false" title="Cambiar tema">
            <svg class="theme-icon-moon size-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 14.4A8 8 0 0 1 9.6 3.5 8.5 8.5 0 1 0 20.5 14.4Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <svg class="theme-icon-sun size-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke-linecap="round"/></svg>
          </button>
          <a href={urlFor('manuales/')} class="ui-action hidden sm:inline-flex min-h-11 items-center gap-2 rounded-xl bg-primary px-4 text-sm font-bold text-primary-foreground hover:brightness-105">
            <BookOpen className="size-4 shrink-0" aria-hidden="true" />
            <span>Explorar biblioteca</span>
            <ArrowUpRight className="size-4 shrink-0" aria-hidden="true" />
          </a>
          <details id="mobile-menu" class="relative lg:hidden group">
            <summary class="ui-action grid size-11 cursor-pointer list-none place-items-center rounded-xl border border-border bg-card hover:bg-accent [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </summary>
            <nav class="absolute right-0 top-14 z-50 w-[min(85vw,18rem)] rounded-2xl border border-border bg-popover p-2.5 text-popover-foreground shadow-2xl" aria-label="Navegación móvil">
              {nav.map(n => {
                const Icon = n.icon;
                const isCurrent = current === n.href;
                return (
                  <a
                    href={n.href}
                    aria-current={isCurrent ? 'page' : undefined}
                    class:list={[
                      'nav-link ui-link flex items-center gap-2.5 rounded-xl px-4 py-3 text-sm font-semibold hover:bg-accent',
                      isCurrent ? 'text-primary bg-accent/60 font-bold' : ''
                    ]}
                  >
                    <Icon className="size-4 shrink-0 text-primary" aria-hidden="true" />
                    <span>{n.label}</span>
                  </a>
                );
              })}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="contenido" class="flex-1"><slot /></main>
    <footer class="border-t border-border bg-card/70">
      <div class="container-site grid gap-8 py-12 md:grid-cols-[1.6fr_1fr_1fr]">
        <div class="max-w-md">
          <div class="flex items-center gap-2 text-base font-extrabold">
            <Building2 className="size-4.5 text-primary shrink-0" aria-hidden="true" />
            <span>Biblioteca HIS · RIS San Miguel</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Herramienta de consulta de documentos oficiales MINSA y orientaciones operativas para IPRESS. Sitio informativo desarrollado para facilitar el registro y control de calidad HIS.</p>
          <p class="mt-3 text-xs text-muted-foreground">No es un sistema oficial del MINSA, no sustituye los manuales originales ni recopila datos de pacientes.</p>
        </div>
        <div class="space-y-3 text-sm">
          <div class="flex items-center gap-2 font-bold">
            <Compass className="size-4 text-primary shrink-0" aria-hidden="true" />
            <span>Navegación</span>
          </div>
          {nav.slice(1).map(n => {
            const Icon = n.icon;
            return (
              <a class="flex items-center gap-2 text-muted-foreground transition-colors hover:text-primary" href={n.href}>
                <Icon className="size-3.5 shrink-0 opacity-60" aria-hidden="true" />
                <span>{n.label}</span>
              </a>
            );
          })}
        </div>
        <div class="space-y-3 text-sm">
          <div class="flex items-center gap-2 font-bold">
            <FileText className="size-4 text-primary shrink-0" aria-hidden="true" />
            <span>Fuentes oficiales</span>
          </div>
          <a class="flex items-center justify-between text-muted-foreground transition-colors hover:text-primary" href="https://bvs.minsa.gob.pe/manuales-del-sistema-de-informacion-his/" target="_blank" rel="noopener noreferrer">
            <span>Biblioteca Virtual MINSA</span>
            <ExternalLink className="size-3.5 shrink-0 opacity-70" aria-hidden="true" />
          </a>
          <a class="flex items-center justify-between text-muted-foreground transition-colors hover:text-primary" href="https://repositorio.minsa.gob.pe/" target="_blank" rel="noopener noreferrer">
            <span>Repositorio institucional MINSA</span>
            <ExternalLink className="size-3.5 shrink-0 opacity-70" aria-hidden="true" />
          </a>
          <p class="text-xs text-muted-foreground pt-1">Material de consulta · 2026</p>
        </div>
      </div>
      <div class="border-t border-border py-4 text-center text-xs text-muted-foreground flex items-center justify-center gap-2">
        <ShieldCheck className="size-3.5 text-primary/70 shrink-0" aria-hidden="true" />
        <span>Soporte informativo para la Red Integrada de Salud San Miguel · DIRESA Cajamarca</span>
      </div>
    </footer>
    <script>
      const root=document.documentElement;
      const toggle=document.querySelector<HTMLButtonElement>('#theme-toggle');
      const meta=document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const applyTheme=(dark:boolean,animate=false)=>{
        if(animate && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
          root.classList.add('theme-changing');
          window.setTimeout(()=>root.classList.remove('theme-changing'),290);
        }
        root.classList.toggle('dark',dark);
        root.style.colorScheme=dark?'dark':'light';
        toggle?.setAttribute('aria-label',dark?'Activar modo claro':'Activar modo oscuro');
        toggle?.setAttribute('aria-pressed',String(dark));
        toggle?.setAttribute('title',dark?'Cambiar a modo claro':'Cambiar a modo oscuro');
        meta?.setAttribute('content',dark?'#131d27':'#f6f9fa');
      };
      applyTheme(root.classList.contains('dark'));
      toggle?.addEventListener('click',()=>{
        const next=!root.classList.contains('dark');
        applyTheme(next,true);
        try{localStorage.setItem('his-theme',next?'dark':'light')}catch{}
      });
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',e=>{
        try{if(!localStorage.getItem('his-theme'))applyTheme(e.matches,true)}catch{}
      });
      window.addEventListener('storage',e=>{
        if(e.key==='his-theme')applyTheme(e.newValue==='dark');
      });
      const menu=document.querySelector<HTMLDetailsElement>('#mobile-menu');
      document.addEventListener('click',e=>{if(menu?.open && e.target instanceof Node && !menu.contains(e.target))menu.open=false});
      document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus()}});
    </script>
  </body>
</html>