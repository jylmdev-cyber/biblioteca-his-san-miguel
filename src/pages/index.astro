---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { urlFor } from '@/lib/urls';
import {
  Search,
  ArrowRight,
  ArrowUpRight,
  CheckCircle2,
  BookOpen,
  BookOpenText,
  FileCheck2,
  Clock,
  History,
  Activity,
  Users,
  User,
  Heart,
  HeartHandshake,
  FileSpreadsheet,
  Sparkles,
  Calendar,
  CheckSquare,
  ShieldCheck,
  Stethoscope,
  Baby,
  Syringe,
  Brain,
  Ribbon,
  Smile,
  Droplets,
  Compass,
  Hash,
  Layers,
  FileText
} from 'lucide-react';

const entries = await getCollection('manuales');
const countPdf = entries.filter(m => m.data.status === 'verificado').length;
const highlights = entries
  .filter(m => m.data.featured)
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0))
  .slice(0, 6);
const historical = entries.filter(m => m.data.year && m.data.year <= 2022);

// Atajos rápidos directos para las estrategias más consultadas en la RIS San Miguel
const quickShortcuts = [
  { label: 'Tuberculosis', query: 'tuberculosis', icon: Stethoscope, color: 'text-teal-600 dark:text-teal-400 bg-teal-500/10 border-teal-500/20 hover:border-teal-500/50' },
  { label: 'Materno Perinatal', query: 'materno', icon: Heart, color: 'text-rose-600 dark:text-rose-400 bg-rose-500/10 border-rose-500/20 hover:border-rose-500/50' },
  { label: 'Inmunizaciones', query: 'inmunizaciones', icon: Syringe, color: 'text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 border-cyan-500/20 hover:border-cyan-500/50' },
  { label: 'Etapa Niño', query: 'nino', icon: Baby, color: 'text-sky-600 dark:text-sky-400 bg-sky-500/10 border-sky-500/20 hover:border-sky-500/50' },
  { label: 'Anemia', query: 'anemia', icon: Droplets, color: 'text-red-600 dark:text-red-400 bg-red-500/10 border-red-500/20 hover:border-red-500/50' },
  { label: 'Salud Mental', query: 'salud mental', icon: Brain, color: 'text-fuchsia-600 dark:text-fuchsia-400 bg-fuchsia-500/10 border-fuchsia-500/20 hover:border-fuchsia-500/50' },
  { label: 'Prevención Cáncer', query: 'cancer', icon: Ribbon, color: 'text-purple-600 dark:text-purple-400 bg-purple-500/10 border-purple-500/20 hover:border-purple-500/50' },
  { label: 'Salud Bucal', query: 'bucal', icon: Smile, color: 'text-blue-600 dark:text-blue-400 bg-blue-500/10 border-blue-500/20 hover:border-blue-500/50' },
  { label: 'Adulto Mayor', query: 'adulto mayor', icon: HeartHandshake, color: 'text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/20 hover:border-amber-500/50' },
];

const categories = [
  {
    title: 'Estrategias sanitarias',
    short: 'Tuberculosis, cáncer, VIH/ITS, inmunizaciones y enfermedades no transmisibles.',
    icon: Activity,
    colorClass: 'bg-teal-500/12 text-teal-700 dark:bg-teal-400/15 dark:text-teal-300',
    borderHover: 'hover:border-teal-500/50',
    n: entries.filter(m => m.data.category === 'Estrategias sanitarias').length
  },
  {
    title: 'Curso de vida',
    short: 'Atención integral en niño, adolescente, joven, adulto y adulto mayor.',
    icon: Users,
    colorClass: 'bg-sky-500/12 text-sky-700 dark:bg-sky-400/15 dark:text-sky-300',
    borderHover: 'hover:border-sky-500/50',
    n: entries.filter(m => m.data.category === 'Curso de vida').length
  },
  {
    title: 'Atención y prevención',
    short: 'Materno perinatal, prevención de anemia, planificación familiar y promoción.',
    icon: Heart,
    colorClass: 'bg-rose-500/12 text-rose-700 dark:bg-rose-400/15 dark:text-rose-300',
    borderHover: 'hover:border-rose-500/50',
    n: entries.filter(m => m.data.category === 'Atención y prevención').length
  },
  {
    title: 'Herramientas transversales',
    short: 'Guía de hoja HIS, criterios P/D/R, valores LAB y control de calidad OITE.',
    icon: FileSpreadsheet,
    colorClass: 'bg-indigo-500/12 text-indigo-700 dark:bg-indigo-400/15 dark:text-indigo-300',
    borderHover: 'hover:border-indigo-500/50',
    n: entries.filter(m => m.data.category === 'Herramientas transversales').length
  },
];

// Helper para asignar icono temático y paleta a manuales destacados
function getHighlightTheme(slug: string, course?: string) {
  const s = slug.toLowerCase();
  const c = (course || '').toLowerCase();
  if (s.includes('tuberculosis')) return { icon: Stethoscope, color: 'bg-teal-500/12 text-teal-700 dark:bg-teal-400/15 dark:text-teal-300' };
  if (s.includes('materno')) return { icon: Heart, color: 'bg-rose-500/12 text-rose-700 dark:bg-rose-400/15 dark:text-rose-300' };
  if (s.includes('nino') || c.includes('niño') || c.includes('nino')) return { icon: Baby, color: 'bg-sky-500/12 text-sky-700 dark:bg-sky-400/15 dark:text-sky-300' };
  if (s.includes('inmunizaciones')) return { icon: Syringe, color: 'bg-cyan-500/12 text-cyan-700 dark:bg-cyan-400/15 dark:text-cyan-300' };
  if (s.includes('cancer')) return { icon: Ribbon, color: 'bg-purple-500/12 text-purple-700 dark:bg-purple-400/15 dark:text-purple-300' };
  if (s.includes('salud-mental')) return { icon: Brain, color: 'bg-fuchsia-500/12 text-fuchsia-700 dark:bg-fuchsia-400/15 dark:text-fuchsia-300' };
  if (s.includes('adulto-mayor') || c.includes('mayor')) return { icon: HeartHandshake, color: 'bg-amber-500/12 text-amber-700 dark:bg-amber-400/15 dark:text-amber-300' };
  if (s.includes('adulto') || c.includes('adulto')) return { icon: User, color: 'bg-blue-500/12 text-blue-700 dark:bg-blue-400/15 dark:text-blue-300' };
  return { icon: BookOpenText, color: 'bg-accent text-accent-foreground' };
}
---
<SiteLayout title="Inicio — Biblioteca HIS · RIS San Miguel" description="Plataforma de consulta rápida de manuales HIS MINSA para el personal de salud y digitadores de la Red Integrada de Salud San Miguel – DIRESA Cajamarca.">
  
  {/* ══════════════════════════════════════════════════════════════════
      1. HERO PRINCIPAL: Buscador destacado y valor institucional
     ══════════════════════════════════════════════════════════════════ */}
  <section class="hero-mesh relative overflow-hidden border-b border-border">
    <div class="container-site grid items-center gap-12 py-12 sm:py-16 md:py-20 lg:grid-cols-[1.12fr_.88fr] lg:py-24">
      <div>
        {/* Badge institucional */}
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-wider text-primary shadow-xs">
          <ShieldCheck className="size-3.5 shrink-0" aria-hidden="true" />
          <span>RIS San Miguel · DIRESA Cajamarca</span>
        </div>

        {/* Título principal con jerarquía fuerte */}
        <h1 class="mt-5 max-w-3xl text-3xl font-extrabold tracking-tight sm:text-5xl lg:text-[3.8rem] leading-[1.08]">
          El manual HIS que necesitas, <span class="text-primary underline decoration-primary/30 decoration-wavy underline-offset-8">al instante.</span>
        </h1>

        {/* Subtítulo orientador y profesional */}
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
          Herramienta de consulta rápida de codificación sanitaria <strong class="text-foreground font-semibold">CIE-10, CPMS y valores LAB</strong>. Diseñada para agilizar el registro clínico y optimizar el control de calidad en las IPRESS de la Red.
        </p>

        {/* Buscador destacado */}
        <form
          action={urlFor('manuales/')}
          method="get"
          role="search"
          class="mt-8 flex max-w-xl flex-col gap-2 rounded-2xl border border-input bg-card p-2 shadow-lg shadow-black/5 transition-all duration-200 focus-within:border-ring focus-within:ring-3 focus-within:ring-ring/25 sm:flex-row"
        >
          <label class="flex min-w-0 flex-1 items-center gap-3 px-3 py-1" for="busqueda-hero">
            <Search className="size-5 shrink-0 text-muted-foreground/75" aria-hidden="true" />
            <span class="sr-only">Buscar manuales o códigos</span>
            <input
              id="busqueda-hero"
              name="q"
              autocomplete="off"
              class="h-12 min-w-0 flex-1 bg-transparent text-[15px] text-foreground outline-none placeholder:text-muted-foreground/75"
              placeholder="Buscar por tema, programa o código (ej. tuberculosis, A150, anemia)…"
            />
          </label>
          <button
            class="ui-action inline-flex h-12 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-xl bg-primary px-6 text-sm font-bold text-primary-foreground transition-transform hover:brightness-105 active:scale-[0.98]"
            type="submit"
          >
            <span>Buscar</span>
            <ArrowRight className="size-4 shrink-0" aria-hidden="true" />
          </button>
        </form>

        {/* Acciones directas secundarias */}
        <div class="mt-4 flex flex-wrap items-center gap-3 text-xs">
          <a
            href={urlFor('manuales/')}
            class="inline-flex items-center gap-1.5 font-bold text-primary underline underline-offset-4 transition-colors hover:text-primary/80"
          >
            <BookOpen className="size-3.5" aria-hidden="true" />
            <span>Explorar catálogo completo ({entries.length} manuales)</span>
            <ArrowUpRight className="size-3.5" aria-hidden="true" />
          </a>
          <span class="text-border">·</span>
          <a
            href={urlFor('codigos/')}
            class="inline-flex items-center gap-1 font-semibold text-muted-foreground hover:text-foreground"
          >
            <Hash className="size-3.5 text-primary/70" aria-hidden="true" />
            <span>Buscador de códigos</span>
          </a>
          <span class="text-border">·</span>
          <a
            href={urlFor('guia-his/')}
            class="inline-flex items-center gap-1 font-semibold text-muted-foreground hover:text-foreground"
          >
            <Compass className="size-3.5 text-primary/70" aria-hidden="true" />
            <span>Guía P/D/R</span>
          </a>
        </div>
      </div>

      {/* ── LADO DERECHO: Tarjeta Interactiva de Muestra Clínica ── */}
      <div class="relative mx-auto w-full max-w-[500px] lg:max-w-none">
        <div class="absolute -left-10 -top-10 size-48 rounded-full bg-primary/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="relative rounded-2xl border border-border bg-card p-5 shadow-xl shadow-black/5 sm:p-7">
          
          {/* Header de la tarjeta */}
          <div class="flex items-center justify-between border-b border-border pb-4">
            <div class="flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-xl bg-teal-500/12 text-teal-700 dark:bg-teal-400/15 dark:text-teal-300">
                <Stethoscope className="size-5" aria-hidden="true" />
              </span>
              <div>
                <div class="text-sm font-extrabold tracking-tight">Registro HIS en tiempo real</div>
                <div class="text-[11px] text-muted-foreground">Estrategia Sanitaria · Tuberculosis 2025</div>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-[10px] font-bold text-emerald-800 dark:text-emerald-300">
              <CheckCircle2 className="size-3" aria-hidden="true" />
              Oficial MINSA
            </span>
          </div>

          {/* Caja explicativa de procedimiento */}
          <div class="mt-4 rounded-xl border border-border bg-muted/40 p-3.5 text-xs">
            <div class="font-bold text-foreground flex items-center justify-between">
              <span>Censo y examen de contactos</span>
              <span class="text-[10px] font-semibold text-muted-foreground uppercase">Manual p. 17–18</span>
            </div>
            <p class="mt-1 leading-relaxed text-muted-foreground">
              Requiere codificación combinada según modalidad: establecimiento, domicilio o telemedicina.
            </p>
          </div>

          {/* Tabla de códigos de muestra */}
          <div class="mt-3.5 overflow-hidden rounded-xl border border-border">
            <div class="grid grid-cols-[1.5fr_.6fr_.6fr] bg-muted/80 px-3.5 py-2.5 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
              <span>Código CPMS / Actividad</span>
              <span class="text-center">Tipo</span>
              <span class="text-right">LAB</span>
            </div>
            <div class="divide-y divide-border text-xs">
              <div class="grid grid-cols-[1.5fr_.6fr_.6fr] items-center px-3.5 py-2.5">
                <div>
                  <code class="font-bold text-primary font-mono text-[13px]">99199.57</code>
                  <div class="text-[11px] text-muted-foreground">Censo de contactos</div>
                </div>
                <div class="text-center">
                  <span class="rounded-md bg-accent px-1.5 py-0.5 text-[11px] font-bold text-primary">D</span>
                </div>
                <div class="text-right text-muted-foreground font-mono">—</div>
              </div>
              <div class="grid grid-cols-[1.5fr_.6fr_.6fr] items-center px-3.5 py-2.5">
                <div>
                  <code class="font-bold text-primary font-mono text-[13px]">99216</code>
                  <div class="text-[11px] text-muted-foreground">Consultorio enfermería</div>
                </div>
                <div class="text-center">
                  <span class="rounded-md bg-accent px-1.5 py-0.5 text-[11px] font-bold text-primary">D</span>
                </div>
                <div class="text-right text-muted-foreground font-mono">—</div>
              </div>
            </div>
          </div>

          {/* Footer de tarjeta */}
          <div class="mt-4 flex items-center justify-between pt-2 text-xs">
            <span class="text-[11px] text-muted-foreground">Respaldo BVS MINSA n.° 7986</span>
            <a
              href={urlFor('manuales/tuberculosis/')}
              class="inline-flex items-center gap-1 font-bold text-primary underline underline-offset-4 hover:text-primary/80"
            >
              <span>Ver ficha completa</span>
              <ArrowUpRight className="size-3.5" aria-hidden="true" />
            </a>
          </div>
        </div>

        {/* Badge flotante inferior */}
        <div class="mt-3 hidden sm:flex items-center justify-between rounded-xl border border-border bg-card/90 px-4 py-2.5 shadow-sm backdrop-blur-xs text-xs">
          <span class="flex items-center gap-2 font-semibold text-foreground">
            <CheckCircle2 className="size-4 text-emerald-600 dark:text-emerald-400 shrink-0" aria-hidden="true" />
            Validación de registros clínicos para IPRESS
          </span>
          <span class="text-muted-foreground">Actualizado 2026</span>
        </div>
      </div>
    </div>
  </section>

  {/* ══════════════════════════════════════════════════════════════════
      2. ATRACTIVAS MÉTRICAS E INDICADORES DE CONFIANZA
     ══════════════════════════════════════════════════════════════════ */}
  <section class="border-b border-border bg-card/40">
    <div class="container-site grid grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-border py-6 sm:grid-cols-4">
      <div class="p-3 text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <BookOpen className="size-5 text-primary opacity-80" aria-hidden="true" />
          <span class="text-2xl sm:text-3xl font-extrabold tracking-tight tabular-nums">{entries.length}</span>
        </div>
        <div class="mt-1 text-xs font-semibold text-muted-foreground">Manuales catalogados</div>
      </div>
      <div class="p-3 text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <FileCheck2 className="size-5 text-emerald-600 dark:text-emerald-400 opacity-90" aria-hidden="true" />
          <span class="text-2xl sm:text-3xl font-extrabold tracking-tight tabular-nums">{countPdf}</span>
        </div>
        <div class="mt-1 text-xs font-semibold text-muted-foreground">PDFs oficiales verificados</div>
      </div>
      <div class="p-3 text-center sm:text-left pt-5 sm:pt-3">
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <Hash className="size-5 text-primary opacity-80" aria-hidden="true" />
          <span class="text-2xl sm:text-3xl font-extrabold tracking-tight">CIE-10 & CPMS</span>
        </div>
        <div class="mt-1 text-xs font-semibold text-muted-foreground">Códigos y valores LAB</div>
      </div>
      <div class="p-3 text-center sm:text-left pt-5 sm:pt-3">
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <Clock className="size-5 text-primary opacity-80" aria-hidden="true" />
          <span class="text-2xl sm:text-3xl font-extrabold tracking-tight">24/7</span>
        </div>
        <div class="mt-1 text-xs font-semibold text-muted-foreground">Acceso web estático y rápido</div>
      </div>
    </div>
  </section>

  {/* ══════════════════════════════════════════════════════════════════
      3. ACCESOS RÁPIDOS POR ESTRATEGIA (Atajos de 1 Clic)
     ══════════════════════════════════════════════════════════════════ */}
  <section class="container-site py-12 sm:py-16">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div>
        <div class="eyebrow flex items-center gap-1.5">
          <Sparkles className="size-3.5 text-primary" aria-hidden="true" />
          <span>Acceso inmediato</span>
        </div>
        <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight sm:text-3xl">Estrategias y programas frecuentes</h2>
      </div>
      <span class="text-xs font-medium text-muted-foreground">Selecciona para filtrar al instante</span>
    </div>

    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4 lg:grid-cols-8">
      {quickShortcuts.map((item) => {
        const Icon = item.icon;
        return (
          <a
            href={`${urlFor('manuales/')}?q=${encodeURIComponent(item.query)}`}
            class:list={[
              'group interactive-card flex flex-col items-center justify-center rounded-2xl border p-3.5 text-center transition-all duration-200',
              item.color
            ]}
          >
            <span class="grid size-10 place-items-center rounded-xl bg-background shadow-xs transition-transform duration-200 group-hover:scale-110">
              <Icon className="size-5" aria-hidden="true" />
            </span>
            <span class="mt-2.5 text-xs font-bold leading-snug text-foreground">
              {item.label}
            </span>
          </a>
        );
      })}
    </div>
  </section>

  {/* ══════════════════════════════════════════════════════════════════
      4. MACRO-ÁREAS DE ATENCIÓN: Organización completa
     ══════════════════════════════════════════════════════════════════ */}
  <section class="border-t border-border bg-card/50 py-16 sm:py-20" id="categorias">
    <div class="container-site">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="eyebrow flex items-center gap-1.5">
            <Layers className="size-3.5 text-primary" aria-hidden="true" />
            <span>Estructura por macro-áreas</span>
          </span>
          <h2 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl lg:text-4xl">Todo el HIS, organizado</h2>
          <p class="mt-2 text-sm text-muted-foreground max-w-2xl">
            Explora los manuales agrupados según la estrategia sanitaria o la etapa de vida que atiendes en tu establecimiento.
          </p>
        </div>
        <a href={urlFor('manuales/')} class="inline-flex items-center gap-1.5 text-sm font-bold text-primary underline underline-offset-4 hover:text-primary/80">
          <span>Ver todo el catálogo</span>
          <ArrowUpRight className="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {categories.map((c) => {
          const Icon = c.icon;
          return (
            <a
              href={`${urlFor('manuales/')}?categoria=${encodeURIComponent(c.title)}`}
              class:list={[
                'group interactive-card flex flex-col justify-between rounded-2xl border border-border bg-card p-6 transition-all duration-200',
                c.borderHover
              ]}
            >
              <div>
                <div class:list={['grid size-12 place-items-center rounded-xl transition-transform duration-200 group-hover:scale-105', c.colorClass]}>
                  <Icon className="size-6" aria-hidden="true" />
                </div>
                <h3 class="mt-5 text-lg font-extrabold leading-snug">{c.title}</h3>
                <p class="mt-2.5 text-xs leading-relaxed text-muted-foreground line-clamp-3">{c.short}</p>
              </div>
              <div class="mt-6 flex items-center justify-between border-t border-border pt-4 text-xs font-bold text-primary">
                <span>{c.n} documentos</span>
                <span class="inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                  Ver fichas
                  <ArrowUpRight className="size-3.5" aria-hidden="true" />
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ══════════════════════════════════════════════════════════════════
      5. MANUALES DESTACADOS (Más consultados)
     ══════════════════════════════════════════════════════════════════ */}
  <section class="border-t border-border py-16 sm:py-20">
    <div class="container-site">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
        <div>
          <span class="eyebrow flex items-center gap-1.5">
            <Sparkles className="size-3.5 text-primary" aria-hidden="true" />
            <span>Selección prioritaria</span>
          </span>
          <h2 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl lg:text-4xl">Manuales más consultados</h2>
          <p class="mt-2 text-sm text-muted-foreground">Documentos vigentes de uso cotidiano en el primer y segundo nivel de atención.</p>
        </div>
        <a class="inline-flex items-center gap-1.5 text-sm font-bold text-primary underline underline-offset-4 hover:text-primary/80" href={urlFor('manuales/')}>
          <span>Explorar todos ({entries.length})</span>
          <ArrowRight className="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {highlights.map((m) => {
          const theme = getHighlightTheme(m.id, m.data.course);
          const Icon = theme.icon;
          return (
            <div class="group interactive-card flex h-full flex-col justify-between rounded-2xl border border-border bg-card p-6 transition-all duration-200">
              <div>
                <div class="flex items-start justify-between gap-3">
                  <span class:list={['grid size-11 place-items-center rounded-xl transition-transform duration-200 group-hover:scale-105', theme.color]}>
                    <Icon className="size-5" aria-hidden="true" />
                  </span>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="inline-flex items-center gap-1 rounded-full border border-border bg-secondary/60 px-2.5 py-0.5 text-[11px] font-semibold text-secondary-foreground tabular-nums">
                      <Calendar className="size-3 text-muted-foreground" aria-hidden="true" />
                      {m.data.year || '—'}
                    </span>
                    {m.data.status === 'verificado' && (
                      <span class="inline-flex items-center gap-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-800 dark:text-emerald-300">
                        <CheckCircle2 className="size-3" aria-hidden="true" />
                        PDF
                      </span>
                    )}
                  </div>
                </div>

                <div class="mt-4 text-[10.5px] font-bold uppercase tracking-[.1em] text-primary/85">
                  {m.data.category}
                </div>
                <h3 class="mt-1.5 text-[17px] font-bold leading-snug tracking-tight text-foreground">
                  {m.data.title}
                </h3>
                <p class="mt-2.5 text-xs leading-relaxed text-muted-foreground line-clamp-3">
                  {m.data.description}
                </p>
              </div>

              <div class="mt-6 border-t border-border pt-4">
                <a
                  href={urlFor(`manuales/${m.id}/`)}
                  class="ui-action flex min-h-10 items-center justify-between rounded-xl border border-border bg-muted/40 px-3.5 text-xs font-bold text-primary transition-all duration-150 hover:border-primary/40 hover:bg-primary/8"
                >
                  <span class="flex items-center gap-2">
                    <FileText className="size-3.5" aria-hidden="true" />
                    Consultar ficha y códigos
                  </span>
                  <ArrowUpRight className="size-3.5 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* ══════════════════════════════════════════════════════════════════
      6. EDICIONES HISTÓRICAS: Transparencia y Trazabilidad
     ══════════════════════════════════════════════════════════════════ */}
  <section class="border-t border-border bg-card/60 py-12 sm:py-16">
    <div class="container-site">
      <div class="flex flex-wrap items-center justify-between gap-6 rounded-2xl border border-border bg-card p-6 shadow-xs sm:p-8">
        <div class="max-w-2xl">
          <span class="eyebrow flex items-center gap-1.5">
            <History className="size-3.5 text-primary" aria-hidden="true" />
            <span>Archivo institucional · MINSA</span>
          </span>
          <h2 class="mt-2 text-2xl font-extrabold tracking-tight">Manuales históricos desde 2019</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            Conservamos <strong class="text-foreground">{historical.length} ediciones oficiales</strong> de 2019 a 2022 para auditorías, revisión de historias clínicas antiguas y capacitación. Recuerda verificar siempre la vigencia normativa antes de registrar nuevas atenciones.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={`${urlFor('manuales/')}?ano=2019`}
            class="ui-action inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground hover:brightness-105"
          >
            <History className="size-4 shrink-0" aria-hidden="true" />
            <span>Explorar ediciones 2019–2022</span>
            <ArrowRight className="size-4 shrink-0" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ══════════════════════════════════════════════════════════════════
      7. HERRAMIENTAS PARA DIGITADORES Y ASISTENCIALES
     ══════════════════════════════════════════════════════════════════ */}
  <section class="border-t border-border py-16 sm:py-20">
    <div class="container-site">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="eyebrow flex items-center justify-center gap-1.5">
          <CheckSquare className="size-3.5 text-primary" aria-hidden="true" />
          <span>Soporte a la digitación</span>
        </span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Menos dudas al registrar. Mejor calidad de datos.</h2>
        <p class="mt-3 text-sm text-muted-foreground">
          Herramientas complementarias para el personal de admisión, enfermería, medicina, obstetricia y digitadores de las IPRESS de San Miguel.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {/* Tool 1: Guía rápida */}
        <div class="interactive-card rounded-2xl border border-border bg-card p-6 flex flex-col justify-between">
          <div>
            <span class="grid size-12 place-items-center rounded-xl bg-teal-500/12 text-teal-700 dark:bg-teal-400/15 dark:text-teal-300">
              <Compass className="size-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 text-lg font-extrabold">Guía rápida de llenado</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
              Aprende a diferenciar el tipo de diagnóstico (P, D, R) y la correcta asignación de casilleros auxiliares LAB 1, 2 y 3.
            </p>
          </div>
          <a
            href={urlFor('guia-his/')}
            class="ui-action mt-6 inline-flex min-h-10 items-center justify-between rounded-xl border border-border bg-muted/40 px-4 text-xs font-bold text-primary hover:bg-primary/8"
          >
            <span>Ver guía P/D/R y LAB</span>
            <ArrowRight className="size-3.5" aria-hidden="true" />
          </a>
        </div>

        {/* Tool 2: Buscador de Códigos */}
        <div class="interactive-card rounded-2xl border border-border bg-card p-6 flex flex-col justify-between">
          <div>
            <span class="grid size-12 place-items-center rounded-xl bg-sky-500/12 text-sky-700 dark:bg-sky-400/15 dark:text-sky-300">
              <Hash className="size-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 text-lg font-extrabold">Buscador de códigos</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
              Localiza códigos CIE-10 y CPMS con un solo clic. Copia códigos directamente al portapapeles con número de página de referencia.
            </p>
          </div>
          <a
            href={urlFor('codigos/')}
            class="ui-action mt-6 inline-flex min-h-10 items-center justify-between rounded-xl border border-border bg-muted/40 px-4 text-xs font-bold text-primary hover:bg-primary/8"
          >
            <span>Buscar códigos HIS</span>
            <ArrowRight className="size-3.5" aria-hidden="true" />
          </a>
        </div>

        {/* Tool 3: Checklist de Digitación */}
        <div class="interactive-card rounded-2xl border border-border bg-card p-6 flex flex-col justify-between">
          <div>
            <span class="grid size-12 place-items-center rounded-xl bg-amber-500/12 text-amber-700 dark:bg-amber-400/15 dark:text-amber-300">
              <CheckSquare className="size-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 text-lg font-extrabold">Puntos de digitación</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
              Checklist de control de calidad previo a la consolidación de tramas. Imprimible para la mesa de trabajo en el establecimiento.
            </p>
          </div>
          <a
            href={urlFor('puntos-digitacion/')}
            class="ui-action mt-6 inline-flex min-h-10 items-center justify-between rounded-xl border border-border bg-muted/40 px-4 text-xs font-bold text-primary hover:bg-primary/8"
          >
            <span>Abrir checklist interactivo</span>
            <ArrowRight className="size-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

</SiteLayout>
