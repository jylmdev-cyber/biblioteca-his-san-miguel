---
import SiteLayout from '@/layouts/SiteLayout.astro';
import CodesExplorer from '@/components/islands/CodesExplorer';
import { codes } from '@/data/codes';
import { getCollection } from 'astro:content';
import { urlFor } from '@/lib/urls';
const manuals=await getCollection('manuales');
const refs: Record<string, string> = Object.fromEntries(
  manuals.filter(m => Boolean(m.data.pdf)).map(m => [m.id, m.data.pdf as string])
);
---
<SiteLayout title="Índice de códigos CIE-10 y CPMS">
  <section class="border-b border-border bg-card/70"><div class="container-site py-12"><span class="eyebrow">Referencia técnica</span><h1 class="mt-3 text-4xl font-extrabold tracking-tight">Índice de códigos HIS</h1><p class="mt-4 max-w-3xl text-sm leading-7 text-muted-foreground">Consulta una selección de códigos CIE-10 y CPMS con nombre, manual de origen y número de página. Esta lista <strong>no es exhaustiva</strong> y no reemplaza la verificación de valores LAB y secuencia de registro.</p></div></section>
  <div class="container-site py-10"><CodesExplorer client:visible items={codes} refs={refs} base={urlFor('')}/><div class="mt-10 rounded-xl bg-accent/60 p-5 text-sm text-muted-foreground">Los códigos proceden de ediciones identificadas. En especial, para documentos sin año confirmado, comprueba que el código siga vigente antes de utilizarlo en producción.</div></div>
</SiteLayout>
